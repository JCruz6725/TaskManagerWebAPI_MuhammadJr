    "Education": "Education",
    "WorkId": "99dafecc-0a8c-47f6-8135-dbd783594f9b",
    "Work": "Work",
    "PersonalId": "c3722436-57b3-44e0-9923-d7b177311aba",
    "Personal": "Personal"
  },

  "LicenseTypeSetting": {
    "FreeId": "a6698723-1fbc-48d6-b30e-a42eaada7453",
    "Free": "Free",
    "PaidId": "f92d11ca-b47d-45c8-ad09-83fa0e99c073",
    "Paid": "Paid"
  }


}
